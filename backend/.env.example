PORT=4000
ANTHROPIC_API_KEY=your_anthropic_api_key_here
NODE_ENV=development

# JWT signing secret for auth — set a real random value in production
JWT_SECRET=change-me-in-production

# Optional but recommended: without this, the Maintenance page's changelog
# hits GitHub's public rate limit (60 req/hour, shared across the sandbox/host IP).
# A read-only fine-grained PAT with "Contents: Read" on this repo is enough.
GITHUB_TOKEN=
GITHUB_REPO=DhanushPalani31/Grovance

# Must match the frontend's VITE_GOOGLE_CLIENT_ID — used to verify Google ID tokens
GOOGLE_CLIENT_ID=
