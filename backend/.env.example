PORT=4000
NODE_ENV=development

# Free — no credit card needed. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The app's database (just leads + activity log now — no user accounts).
# Create a project at supabase.com, then run backend/supabase/schema.sql
# in its SQL Editor once before first use.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# In production, set this to your deployed frontend's exact URL to restrict
# CORS to just that origin. Leave unset for local dev.
FRONTEND_URL=

# Email notifications when a lead comes in (Contact form or Automation Audit).
# Free at resend.com — no domain needed since you're only sending to your
# own email, not to strangers. NOTIFY_EMAIL is where alerts get sent.
RESEND_API_KEY=
NOTIFY_EMAIL=grovanceco@gmail.com

# Optional: lets the app also reply directly to visitors (a contextual
# auto-reply on Contact form submissions, and their own audit result by
# email). Requires a domain you've verified with Resend — sending TO
# strangers isn't possible without one, even on the free plan. Leave blank
# to skip visitor auto-replies entirely (owner notification + DB save still
# work fine without this).
FROM_EMAIL=
